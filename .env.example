# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE SHEETS INTEGRATION
# Spreadsheet: "J Square Booking & Payment Tracker" | Sheet Tab: "Bookings"
# Option A: Google Apps Script Web App (Recommended for seamless serverless sync)
GOOGLE_SHEETS_WEBHOOK_URL=""
GOOGLE_SHEETS_SECRET="CHANGE_THIS_TO_A_LONG_RANDOM_TEXT"

# Option B: Direct Google Sheets API v4 (Requires OAuth access token or Google Service Account)
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_WORKSPACE_ACCESS_TOKEN=""

# UPI & PAYMENT WEBHOOK INTEGRATION
# Secret used to verify HMAC-SHA256 signatures on incoming provider webhooks
PAYMENT_WEBHOOK_SECRET="jsquare-webhook-secret-2026"

# STAFF RECONCILIATION AUTHENTICATION
# Secret required for authorized lab staff manual reconciliation of direct UPI transfers
STAFF_ADMIN_SECRET="jsquare-staff-2026"

# PAYMENT MODE: 'sandbox' | 'production'
PAYMENT_MODE="sandbox"

# META WHATSAPP BUSINESS CLOUD API INTEGRATION
# Business Phone Number: +91 86910 27116 (Desk Support)
WHATSAPP_API_TOKEN="YOUR_WHATSAPP_CLOUD_API_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_WHATSAPP_BUSINESS_ACCOUNT_ID"
